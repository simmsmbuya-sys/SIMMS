{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Preserve",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"esModuleInterop": true,
		"resolveJsonModule": false,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"strict": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true
	},
	"include": ["./src", "./skills"]
}
